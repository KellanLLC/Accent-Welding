{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf:build": "opennextjs-cloudflare build --skipWranglerConfigCheck",
    "cf:preview": "npm run cf:build && wrangler dev --config ../wrangler.jsonc",
    "cf:deploy": "npm run cf:build && wrangler deploy --config ../wrangler.jsonc",
    "cf:typegen": "wrangler types --config ../wrangler.jsonc --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "motion": "^13.1.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "typescript": "^5",
    "wrangler": "^4.123.0"
  }
}
